@using RohamPaint.ViewModels
@model PagedList.Core.IPagedList

@{
    ViewData["Title"] = "Index";
    var start = Model.MetaData.TotalCount == 0 ? 0 : ((Model.MetaData.CurrentPage - 1) * Model.MetaData.PageSize) + 1;
    var end = start == 0 ? 0 : start + (Model.Colors?.Count ?? 0) - 1;
    var hasSearched = !string.IsNullOrWhiteSpace(ViewContext.HttpContext.Request.Query["search"]);
}


<div class="d-flex flex-column gap-2 align-items-center mt-3">
    <div class="d-flex align-items-center">

        {{!-- Page Size Selector --}}
        <form method="get" class="me-3">
            <label for="pageSize" class="form-label visually-hidden">Page size</label>
            <select id="pageSize" name="pageSize" class="form-select" onchange="this.form.submit()">
                @{
                    var sizes = new[] { 5, 10, 20, 50 };
                }
                @foreach (var s in sizes)
                {
                    <option value="@s" selected="@(s == pageSize ? "selected" : null)">@s</option>
                }
            </select>
            <input type="hidden" name="pageNumber" value="1" />
            @if (!string.IsNullOrEmpty(search))
            {
                <input type="hidden" name="search" value="@search" />
            }
        </form>

        {{!-- Pagination Nav --}}
        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">

                {{!-- Previous Button --}}
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-pageNumber="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-search="@search">Previous</a>
                </li>

                {{!-- Page Number Buttons --}}
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@pageSize"
                           asp-route-search="@search">@i</a>
                    </li>
                }

                {{!-- Next Button --}}
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-pageNumber="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-search="@search">Next</a>
                </li>

            </ul>
        </nav>
    </div>

    {{!-- Record Count Summary --}}
    <div>
        <strong>Showing</strong> @start - @end <strong>of</strong> @totalCount
    </div>
</div>
