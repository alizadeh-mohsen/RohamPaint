<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* <title><%: Page.Title %></title> *@
    <link rel="shortcut icon" type="image/png" href="Images/Favicon.png" />
    <link href="~/css/bootstrap-rtl.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.rtl.min.css" />
    <link href="~/css/main.css" rel="stylesheet" />

    <meta name="description"
          content="رنگ فروشی، خرید رنگ اینترنتی، رنگ ماشین، رنگ اتومبیل ، رنگ صنعتی ، کاتالوگ رنگ، ترکیب رنگ کامپیوتری، قلم خشگیر، بتونه آستر فوری ، اسپری رنگ ، ابزار رنگ، رنگ ساختمانی، رنگ کامپیوتری" />
    <link rel="canonical" href="http://roham-paint.ir" />
    <meta property="og:site_name" content="roham-paint.ir" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://roham-paint.ir" />
    <meta property="og:title" content="رنگ اتومبیل ، ساختمانی و صنعتی، ابزار رنگ، ترکیب رنگ کامپیوتری" />
    <meta property="og:description"
          content="رنگ اتومبیل ، ساختمانی و صنعتی، ابزار رنگ، ترکیب رنگ کامپیوتری" />
    <meta property="og:locale" content="fa_IR" />
    <title></title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="bg-light">

        <nav class="navbar navbar-expand-lg navbar-light bg-primary">
            <div class="container-fluid">

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 px-5">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="Index.html">صفحه اصلی</a>
                        </li>
                        <li class="nav-item">
                        <a class="nav-link text-white" href="/ColorPage/Index">فرمول ترکیب رنگ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="Catalogs.html">کاتالوگ رنگ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Notes">نکات مفید</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="Contact.html">تماس با ما</a>
                        </li>
                    </ul>
                </div>
                <a class="navbar-brand" href="#">
                    <img class="img-thumbnail" src="images/Logo.png" alt="فروشگاه رنگ رهام" />
                </a>
            </div>
        </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

        <footer class="footer">
            <div class="container">
                <span class="text-dark">
                    تمامی حقوق مادی و معنوی متعلق به رنگ رهام می باشد.
                </span>
                <a href="https://www.instagram.com/range_roham/">
                    <img class="img-fluid  mx-2" alt="Instagram"
                         src="images/instagram.png" width="32" height="32" />
                </a>
            </div>
        </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/htmx/htmx.js"></script>

    <script>
                document.body.addEventListener('htmx:configRequest', function (e) {
            const token = document.cookie
                .split(';')
                .find(c => c.trim().startsWith('XSRF-TOKEN='))
                ?.split('=')[1];
            if (token) {
                e.detail.headers['X-XSRF-TOKEN'] = decodeURIComponent(token);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
