@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var currentTheme = HttpContextAccessor.HttpContext?.Request.Cookies["SelectedTheme"] ?? "Default";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RohamPaint</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    @if (currentTheme == "Default")
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    else
    {
        @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.3.3/@currentTheme.ToLower()/bootstrap.min.css" /> *@
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/@currentTheme.ToLower()/bootstrap.min.css" />
    }

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RohamPaint.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand text-light" href="/Admin/Index">Home</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor01">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav me-auto">
                            @*   <li class="nav-item" >
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li> *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" data-bs-toggle="dropdown" href="#" role="button">Basic Information</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item text-light" asp-page="/Admin/BasePage/Index">Base</a>
                                    <a class="dropdown-item text-light" asp-page="/Admin/ColorTypePage/Index">Color Type</a>
                                    <a class="dropdown-item text-light" asp-page="/Admin/CarPage/Index">Make</a>
                                    @* <div class="dropdown-divider"></div> *@
                                    <a class="dropdown-item text-light" asp-page="/Admin/UnitPage/Index">Unit</a>
                                </div>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-page="/Admin/Index">Formul</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-page="/Admin/NotePage/Index">Notes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-page="/Admin/Theme/Index">Theme</a>
                            </li>

                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RohamPaint - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/htmx/htmx.js"></script>


    <script>
                document.body.addEventListener('htmx:configRequest', function (e) {
            const token = document.cookie
                .split(';')
                .find(c => c.trim().startsWith('XSRF-TOKEN='))
                ?.split('=')[1];
            if (token) {
                e.detail.headers['X-XSRF-TOKEN'] = decodeURIComponent(token);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>