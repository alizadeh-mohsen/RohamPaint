@page
@model RohamPaint.Pages.Admin.ColorPage.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Color</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ColorCreateViewModel.CarId" class="control-label"></label>
                <select asp-for="ColorCreateViewModel.CarId" class="form-select" asp-items="ViewBag.CarId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ColorCreateViewModel.ColorTypeId" class="control-label"></label>
                <select asp-for="ColorCreateViewModel.ColorTypeId" class="form-select" asp-items="ViewBag.ColorTypeId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ColorCreateViewModel.Code" class="control-label"></label>
                <input asp-for="ColorCreateViewModel.Code" class="form-control" />
                <span asp-validation-for="ColorCreateViewModel.Code" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ColorCreateViewModel.UnitId" class="control-label"></label>
                <select asp-for="ColorCreateViewModel.UnitId" class="form-select" asp-items="ViewBag.UnitId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ColorCreateViewModel.BaseId" class="control-label"></label>
                <select asp-for="ColorCreateViewModel.BaseId" class="form-select" asp-items="ViewBag.BaseId"></select>
            </div>

            <h5 class="mb-3">Formuls</h5>

            <div id="cities-container">
                @for (int i = 0; i < Model.ColorCreateViewModel.Formuls.Count; i++)
                {
                    <div class="mb-2 formul-row">
                        <input name="ColorCreateViewModel.Formuls[@i].BaseColor" class="form-control d-inline-block w-75" />
                        <input name="ColorCreateViewModel.Formuls[@i].Weight" class="form-control d-inline-block w-75" />
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeFormul(this)">X</button>
                    </div>
                }
            </div>

            <button type="button" class="btn btn-primary" onclick="addFormul()">Add Formul</button>





            <div class="form-group">
                <label asp-for="ColorCreateViewModel.Comment" class="control-label"></label>

                <textarea asp-for="ColorCreateViewModel.Comment" class="form-control" rows="4"></textarea>
                <span asp-validation-for="ColorCreateViewModel.Comment" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ColorCreateViewModel.Usage" class="control-label"></label>
                <textarea asp-for="ColorCreateViewModel.Usage" class="form-control" rows="4"></textarea>
                <span asp-validation-for="ColorCreateViewModel.Usage" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary mt-2" />
                <a asp-page="/Admin/Index" class="btn btn-secondary mt-2 ">Back to List</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
             function addFormul() {
            const container = document.getElementById("cities-container");
            const index = container.children.length;

            const div = document.createElement("div");
            div.classList.add("mb-2", "formul-row");
            div.innerHTML = `
                <input name="ColorCreateViewModel.Formuls[${index}].BaseColor" class="form-control d-inline-block w-75" />
                <input name="ColorCreateViewModel.Formuls[${index}].Weight" class="form-control d-inline-block w-75" />
                <button type="button" class="btn btn-danger btn-sm" onclick="removeFormul(this)">X</button>
            `;
            container.appendChild(div);
        }

        function removeFormul(btn) {
            btn.parentElement.remove();
            // re-index inputs
            const rows = document.querySelectorAll(".formul-row input");
            rows.forEach((input, i) => input.name = `ColorCreateViewModel.Formuls[${i}]`);
        }


    </script>
}