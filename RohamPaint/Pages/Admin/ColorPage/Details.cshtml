@page
@using RohamPaint.ViewModels
@model RohamPaint.Pages.Admin.ColorPage.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<div class="container py-4">

    <h2 class="mb-4">Color Details</h2>

    <!-- ── PART 1: Color Info Card ── -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Color Information</h5>
            <form method="post" class="d-flex gap-2 mb-0">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-light btn-sm" asp-page-handler="PrintFormul">Print Formula</button>
                <button type="submit" class="btn btn-outline-light btn-sm" asp-page-handler="PrintLabel">Print Label</button>
            </form>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Code)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Code)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Comment)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Comment)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Lock)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Lock)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.LastUpdate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.LastUpdate)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Accuracy)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Accuracy)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Usage)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Usage)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Base)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Base)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Car)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Car)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.ColorType)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.ColorType)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color.Unit)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color.Unit)</dd>
            </dl>
        </div>
        <div class="card-footer d-flex gap-2">
            <a class="btn btn-primary btn-sm" asp-page="./Edit" asp-route-id="@Model.Color.ID">Edit</a>
            <a class="btn btn-secondary btn-sm" asp-page="/Admin/Index">Back to List</a>
        </div>
    </div>

    <!-- ── PART 2: Formula Table ── -->
    @if (Model.Color.Formuls.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Mix Formula</h5>
            <a class="btn btn-primary btn-sm" asp-page="./FormulPage/Create" asp-route-ColorId="@Model.Color.ID">+ Add Base Color</a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Color.Formuls[0].BaseColor)</th>
                        <th>@Html.DisplayNameFor(model => model.Color.Formuls[0].Weight)</th>
                        <th></th>
                    </tr>
                </thead>
                <partial name="_FormulsTable" model="new FormulsTableViewModel { Formuls = Model.Color.Formuls }" />
            </table>
        </div>

        <!-- Easy Mix Panel -->
        <div id="easyMixDiv" style="display:none" class="card mb-3 border-primary">
            <div class="card-header text-primary fw-semibold">Easy Mix</div>
            <div class="card-body">
                <form id="easyMixForm" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="formulId" name="formulId" />
                    <input type="hidden" name="colorId" value="@Model.Color.ID" />
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small">Base Color</label>
                            <input type="text" id="baseColor" name="baseColor" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small">Weight</label>
                            <input type="text" id="weight" name="weight" class="form-control form-control-sm" />
                        </div>
                        <div class="col-sm-2 d-flex align-items-end pb-1">
                            <div class="form-check">
                                @* Ensure model binding for bool: send explicit false, checkbox sends true when checked *@
                                <input type="hidden" name="isGram" value="false" />
                                <input class="form-check-input" type="checkbox" id="isGram" name="isGram" value="true" checked />
                                <label class="form-check-label small" for="isGram">Gram</label>
                            </div>
                        </div>
                        <div class="col-sm-3 d-flex gap-2">
                            <button type="button"
                                    hx-post="?handler=Mix"
                                    hx-target="#formuls-tbody"
                                    hx-swap="outerHTML"
                                    hx-include="#easyMixForm"
                                    hx-on::after-request="document.getElementById('easyMixDiv').style.display='none'"
                                    class="btn btn-primary btn-sm">
                                Easy Mix
                            </button>
                            <button type="button" onclick="hideEasyMix()" class="btn btn-outline-secondary btn-sm">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Change Base Panel -->
        <div id="changeBaseDiv" style="display:none" class="card mb-3 border-warning">
            <div class="card-header text-warning fw-semibold">Recalculate Base Weight</div>
            <div class="card-body">
                <form id="changeBaseForm" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="colorId" value="@Model.Color.ID" />
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small">New Weight</label>
                            <input type="text" id="cb_weight" name="cb_weight" class="form-control form-control-sm" />
                        </div>
                        <div class="col-sm-2 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input type="hidden" name="cb_isGram" value="false" />
                                <input class="form-check-input" type="checkbox" id="cb_isGram" name="cb_isGram" value="true" checked />
                                <label class="form-check-label small" for="cb_isGram">Gram</label>
                            </div>
                        </div>
                        <div class="col-sm-3 d-flex gap-2">
                            <button type="button"
                                    hx-post="?handler=ChangeBaseWeight"
                                    hx-target="#formuls-tbody"
                                    hx-swap="outerHTML"
                                    hx-include="#changeBaseForm"
                                    hx-on::after-request="document.getElementById('changeBaseDiv').style.display='none'"
                                    class="btn btn-warning btn-sm">
                                Calculate
                            </button>
                            <button type="button" onclick="hideChangeBase()" class="btn btn-outline-secondary btn-sm">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        function showEasyMix(id, baseColor, weight) {
            document.getElementById('formulId').value = id;
            document.getElementById('baseColor').value = baseColor;
            document.getElementById('weight').value = weight;
            document.getElementById('easyMixDiv').style.display = 'block';
            document.getElementById('changeBaseDiv').style.display = 'none';
        }
        function hideEasyMix() {
            document.getElementById('easyMixDiv').style.display = 'none';
            document.getElementById('baseColor').value = '';
            document.getElementById('weight').value = '';
        }
        function showChangeBase(weight) {
            document.getElementById('cb_weight').value = weight;
            document.getElementById('changeBaseDiv').style.display = 'block';
            document.getElementById('easyMixDiv').style.display = 'none';
        }
        function hideChangeBase() {
            document.getElementById('changeBaseDiv').style.display = 'none';
            document.getElementById('cb_weight').value = '';
        }
    </script>
}
