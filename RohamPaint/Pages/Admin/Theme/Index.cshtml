@page
@model RohamPaint.Pages.Admin.Theme.IndexModel
@{
    ViewData["Title"] = "Admin Theme";
}

<h1>Admin Theme</h1>

<form method="post">
    <div class="mb-3" style="max-width:380px;">
        <label for="SelectedTheme" class="form-label">Choose a Bootswatch theme</label>
        <select asp-for="SelectedTheme" asp-items="Model.ThemeList" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-primary">Change Theme</button>
</form>
