@page
@model RohamPaint.Pages.CarPage.IndexModel

@{
    ViewData["Title"] = "Index";
}


<h1>Car/Company</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New</a>
</p>
<form method="get" class="row g-3 mb-4">
    <div class="col-md-10">
        <input type="text" name="search" class="form-control" placeholder="Search by name" value="@ViewContext.HttpContext.Request.Query["search"]" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
    <input type="hidden" name="pageSize" value="@Model.MetaData.PageSize" />
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Car[0].IsCompany)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Car) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsCompany)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<partial name="_Pagination" model='new RohamPaint.ViewModels.PaginationModel
                            {
                                MetaData = Model.MetaData,
                                ItemCount = Model.Car?.Count ?? 0,
                                Search = ViewContext.HttpContext.Request.Query["search"]
                            }' />
