@page
@using RohamPaint.ViewModels
@model RohamPaint.Pages.ColorPage.DetailsModel
@Html.AntiForgeryToken()
<script src="/path/to/htmx.min.js"></script>
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>




<div>
    <h4>Color</h4>
    <hr />
    <form method="post">
        <button type="submit" class="btn btn-primary" asp-page-handler="PrintFormul">Print Formul</button>
        <button type="submit" class="btn btn-primary" asp-page-handler="PrintLabel">Print Label</button>
    </form>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Code)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Code)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Comment)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Comment)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Lock)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Lock)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.LastUpdate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.LastUpdate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Accuracy)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Accuracy)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Usage)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Usage)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Base)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Base)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Car)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Car)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.ColorType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.ColorType)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Color.Unit)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Color.Unit)
        </dd>
    </dl>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Color.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>


@if (Model.Color.Formuls.Any())
{
    <div>
        <a asp-page="./FormulPage/Create" asp-route-ColorId="@Model.Color.ID">Add Base Color</a> |
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Color.Formuls[0].BaseColor)</th>
                    <th>@Html.DisplayNameFor(model => model.Color.Formuls[0].Weight)</th>
                    <th></th>
                </tr>
            </thead>
            <partial name="_FormulsTable" model="new FormulsTableViewModel { Formuls = Model.Color.Formuls }" />
        </table>
        <div id="easyMixDiv" style="display:none">
            <form id="easyMixForm" method="post">
                <input type="hidden" id="formulId" name="formulId" />
                <input type="hidden" name="colorId" value="@Model.Color.ID" />
                <input type="text" id="baseColor" name="baseColor" class="form-control" readonly />
                <input type="text" id="weight" name="weight" class="form-control" />
                <input type="checkbox" id="isGram" name="isGram" checked /> Gram

                <button type="button"
                        hx-post="?handler=Mix"
                        hx-target="#formuls-tbody"
                        hx-swap="outerHTML"
                        hx-include="#easyMixForm"
                        hx-on::after-request="document.getElementById('easyMixDiv').style.display='none'"
                        class="btn btn-primary">
                    Easy Mix
                </button>
            </form>
        </div>
        <div id="changeBaseDiv" style="display:none">
            <form id="changeBaseForm" method="post">
                <input type="hidden" id="formulId" name="formulId" />
                <input type="hidden" name="colorId" value="@Model.Color.ID" />
                <div> <input type="text" id="weight" name="weight" class="form-control" /></div>
                <div> <input type="checkbox" id="isGram" name="isGram" checked /> Gram</div>
                <div>
                    <button type="button"
                            hx-post="?handler=ChangeBaseWeight"
                            hx-target="#formuls-tbody"
                            hx-swap="outerHTML"
                            hx-include="#changeBaseForm"
                            hx-on::after-request="document.getElementById('changeBaseDiv').style.display='none'"
                            class="btn btn-primary">
                        Calculate
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function showEasyMix(id, baseColor, weight) {
            document.getElementById('formulId').value = id;
            document.getElementById('baseColor').value = baseColor;
            document.getElementById('weight').value = weight;
            document.getElementById('easyMixDiv').style.display = 'block';
        }

        function hideEasyMix() {
            document.getElementById('easyMixDiv').style.display = 'none';
            document.getElementById('baseColor').value = '';
            document.getElementById('weight').value = '';
        }
        function showChangeBase(id, baseColor, weight) {
            document.getElementById('formulId').value = id;
            document.getElementById('baseColor').value = baseColor;
            document.getElementById('weight').value = weight;
            document.getElementById('changeBaseDiv').style.display = 'block';
        }

        function hideChangeBase() {
            document.getElementById('changeBaseDiv').style.display = 'none';
            document.getElementById('baseColor').value = '';
            document.getElementById('weight').value = '';
        }




        document.getElementById("btnAjax").addEventListener("click", () => {
            console.log('clicked');

            const payload = {
                colorId:document.getElementById('colorId').value,
                id: document.getElementById('formulId').value,
                newWeight: document.getElementById('weight').value,
                isGram:document.getElementById('flexCheckDefault').checked,

            };
            console.log(payload);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch("?handler=Mix", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => console.log(data));
        });
    </script>


}